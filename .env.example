# Copy to .env and adjust.

# Host port of the plain-HTTP web container. Use 127.0.0.1:8080 to keep it reachable only
# from this machine (e.g. when the `https` profile or another reverse proxy sits in front).
WEB_PORT=8080

# Public hostname for the `https` profile. Its DNS must point at this host and ports 80/443
# must be reachable so Caddy can obtain a Let's Encrypt certificate.
DOMAIN=baby.example.com
