# Copy to .env and adjust.

# Base domain served by the external Traefik proxy. The app is published at
# https://baby-utils.$DOMAIN, the optional sync API at https://baby-utils.$DOMAIN/api/sync.
DOMAIN=example.com

# Server secret of the sync API (required, at least 16 characters). Only apps that know it
# can use the relay: enter it in the app under Settings → Sync → Sync server. Generate one:
#   openssl rand -base64 32
API_KEY=change-me-to-a-long-random-secret

# Optional: comma-separated browser origins allowed to call the sync API from another host
# (default: any origin — access is controlled by API_KEY, not by the origin).
# CORS_ORIGINS=https://baby-utils.example.com
