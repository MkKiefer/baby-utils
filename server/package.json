{
  "name": "baby-utils-api",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Sync relay for Baby Utils (NestJS): buffers and forwards end-to-end encrypted messages. Requires an API key.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "vitest run --root .. server",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "typescript": "~5.9.3"
  }
}
